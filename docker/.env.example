# cp .env.example .env — .env stays out of the image and out of git.

# DeepSeek API key. Without it the container starts and the UI loads, but every
# model request fails; you can also paste the key into Settings → Models.
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenAI-compatible endpoint override. Empty uses DeepSeek's own endpoint.
DEEPSEEK_BASE_URL=

# Host port for the UI. Bound to 127.0.0.1 only.
DSH_PORT=3080

# Directory the agent gets as its workspace, mounted read-write at /workspace.
# Defaults to ./data/workspace. Point it at a real project to test on one.
DSH_WORKSPACE=./data/workspace

# read-only | workspace-write | danger-full-access.
# workspace-write also asks before operations outside the policy.
DSH_PERMISSION_MODE=workspace-write

# npm dist-tag or exact version of @deepseek-ai/dsh baked into the image.
DSH_VERSION=alpha
